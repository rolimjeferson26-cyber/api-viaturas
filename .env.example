# Modelo das variáveis de ambiente que o projeto precisa.
# Copie para ".env" e preencha. O .env NÃO vai para o GitHub.
# Em produção (Render), cadastre as mesmas variáveis no painel
# (Environment) em vez de usar arquivo.

# Chave que assina os tokens de login. Tem que ser longa e secreta.
# Para gerar uma:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua_chave_aqui

# 1 = liga o modo debug (só no seu PC). Em produção, NÃO defina.
FLASK_DEBUG=1

# Endereço do banco PostgreSQL (Neon). Pegue no painel do Neon:
# Dashboard -> Connect -> copie a "connection string".
# Formato: postgresql://usuario:senha@servidor/banco?sslmode=require
DATABASE_URL=postgresql://usuario:senha@servidor.neon.tech/neondb?sslmode=require
